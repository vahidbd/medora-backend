        "clinician_credentials_registering_body_check": {
          "name": "clinician_credentials_registering_body_check",
          "value": "\"operational\".\"clinician_credentials\".\"registering_body\" in ('ahpra', 'dietitians_australia')"
        },
        "clinician_credentials_registration_type_check": {
          "name": "clinician_credentials_registration_type_check",
          "value": "\"operational\".\"clinician_credentials\".\"registration_type\" in ('general', 'specialist', 'provisional', 'limited')"
        },
        "clinician_credentials_registration_status_check": {
          "name": "clinician_credentials_registration_status_check",
          "value": "\"operational\".\"clinician_credentials\".\"registration_status\" in ('practising', 'non_practising', 'suspended', 'cancelled')"
        },
        "clinician_credentials_endorsement_check": {
          "name": "clinician_credentials_endorsement_check",
          "value": "\"operational\".\"clinician_credentials\".\"endorsement\" in ('nurse_practitioner')"
        },

          "name": "clinician_credentials_withdrawal_reason_check",
          "value": "\"operational\".\"clinician_credentials\".\"withdrawal_reason\" in ('entered_in_error', 'replaced', 'no_longer_held')"
        },
        "clinician_credentials_shape_check": {
          "name": "clinician_credentials_shape_check",
          "value": "case \"operational\".\"clinician_credentials\".\"kind\"\n        when 'registration' then \"operational\".\"clinician_credentials\".\"registering_body\" is not null and \"operational\".\"clinician_credentials\".\"registration_status\" is not null and \"operational\".\"clinician_credentials\".\"reference\" is not null\n          and \"operational\".\"clinician_credentials\".\"expires_on\" is not null and \"operational\".\"clinician_credentials\".\"endorsement\" is null and \"operational\".\"clinician_credentials\".\"insurer\" is null and \"operational\".\"clinician_credentials\".\"covers_telehealth_new_patients\" is null\n        when 'endorsement' then \"operational\".\"clinician_credentials\".\"endorsement\" is not null and \"operational\".\"clinician_credentials\".\"registering_body\" is null and \"operational\".\"clinician_credentials\".\"registration_status\" is null\n          and \"operational\".\"clinician_credentials\".\"registration_type\" is null and \"operational\".\"clinician_credentials\".\"conditions\" is null and \"operational\".\"clinician_credentials\".\"insurer\" is null and \"operational\".\"clinician_credentials\".\"covers_telehealth_new_patients\" is null\n        when 'indemnity' then \"operational\".\"clinician_credentials\".\"insurer\" is not null and \"operational\".\"clinician_credentials\".\"covers_telehealth_new_patients\" is not null and \"operational\".\"clinician_credentials\".\"expires_on\" is not null\n          and \"operational\".\"clinician_credentials\".\"registering_body\" is null and \"operational\".\"clinician_credentials\".\"registration_status\" is null and \"operational\".\"clinician_credentials\".\"registration_type\" is null\n          and \"operational\".\"clinician_credentials\".\"conditions\" is null and \"operational\".\"clinician_credentials\".\"endorsement\" is null\n        else false end"
        },
        "clinician_credentials_dates_check": {
          "name": "clinician_credentials_dates_check",
          "value": "\"operational\".\"clinician_credentials\".\"starts_on\" is null or \"operational\".\"clinician_credentials\".\"expires_on\" is null or \"operational\".\"clinician_credentials\".\"starts_on\" <= \"operational\".\"clinician_credentials\".\"expires_on\""
        },
        "clinician_credentials_verified_check": {
          "name": "clinician_credentials_verified_check",
          "value": "(\"operational\".\"clinician_credentials\".\"verified_at\" is null) = (\"operational\".\"clinician_credentials\".\"verified_by\" is null)"
        },
        "clinician_credentials_reviewed_check": {
          "name": "clinician_credentials_reviewed_check",
          "value": "(\"operational\".\"clinician_credentials\".\"conditions_reviewed_at\" is null) = (\"operational\".\"clinician_credentials\".\"conditions_reviewed_by\" is null)"
        },
        "clinician_credentials_withdrawn_check": {

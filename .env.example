# Copy to .env for local development. Development uses a local Postgres and
# made-up data only. Never put a production or staging key in this file.

MEDORA_ENV=development
PORT=4000
LOG_LEVEL=info

# The API's login: medora_api, a member of medora_app that owns nothing (ADR 0006).
DATABASE_URL=postgres://medora_api:medora_api@127.0.0.1:5432/medora
# The owner, for migrations and the seed only.
DATABASE_MIGRATION_URL=postgres://medora_owner:medora_owner@127.0.0.1:5432/medora

# dev: tokens signed with DEV_JWT_SECRET (tests and local tools). Staging and production refuse it.
AUTH_MODE=dev
DEV_JWT_SECRET=local-development-only-secret-change-me

# Field encryption (ADR 0010). This key is for local development only, and
# staging and production refuse it. Production refuses the local provider.
FIELD_KEY_PROVIDER=local
FIELD_ENCRYPTION_KEY=bWVkb3JhLWxvY2FsLWRldmVsb3BtZW50LWtleS0zMmI=

# Clerk, for AUTH_MODE=clerk. A development instance's publishable key (pk_test_...).
# CLERK_PUBLISHABLE_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# The patient sign-in instance (ADR 0035): a different development instance.
# CLERK_PATIENT_PUBLISHABLE_KEY=
# CLERK_PATIENT_AUTHORIZED_PARTIES=http://localhost:3000
# Staff invitations (docs/decisions/admin.md ADM5). Unset: invitations are saved and no email goes out.
# CLERK_SECRET_KEY=
# CONSOLE_URL=http://localhost:3000

# Error tracking: a Sentry-compatible server in Australia (ADR 0026). Unset: off.
# SENTRY_DSN=

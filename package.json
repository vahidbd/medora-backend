{
  "name": "medora-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Medora API and workers",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/start.js",
    "start:agents": "node dist/agents.js",
    "dev:agents": "tsx watch src/agents.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "node scripts/db-setup.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:seed": "tsx src/db/seed.ts",
    "contract": "tsx scripts/contract.ts",
    "skills:sync": "node scripts/check-skills.mjs --write",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run boundaries && node scripts/check-names.mjs && node scripts/check-file-names.mjs && node scripts/check-migrations.mjs --no-base && node scripts/check-skills.mjs && node scripts/check-adr-sync.mjs && tsx scripts/contract.ts --check && node scripts/check-schema-drift.mjs && tsx scripts/check-evals.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "evals": "tsx scripts/evals.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.2",
    "@anthropic-ai/sdk": "1.11.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/swagger": "9.9.5",
    "@sentry/node": "11.15.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.8.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
